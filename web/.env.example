# ============================================================================
# Cockpit — web/.env.example
# Copiez ce fichier vers web/.env.local pour le dev (jamais commité).
#
# L'interface ne contient AUCUN secret : la seule configuration est l'adresse
# de l'API du backend.
#
# Dev : laisser vide -> l'API est appelée via le proxy Vite (/api -> localhost).
# Prod (Vercel) : renseigner l'URL publique de l'API déployée sur le VPS.
#   NB : pour que le cookie de session fonctionne en production, l'interface
#   et l'API doivent partager le même domaine racine (ex. cockpit.duonexia.be
#   sur Vercel et api.duonexia.be sur le VPS, cookie SameSite=Lax).
# ============================================================================

VITE_API_URL=
