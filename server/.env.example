# ============================================================================
# Cockpit — server/.env.example
# Copiez ce fichier vers server/.env puis renseignez les valeurs réelles.
# AUCUN secret ne doit être commité ; server/.env est ignoré par git.
#
# 1. Base de données (obligatoire au démarrage)
# ============================================================================

# Chaîne de connexion Supabase (Postgres managé).
# Dans Supabase : Project Settings -> Database -> Connection string (URI).
# Le schéma est appliqué par `npm run db:migrate` (voir README).
DATABASE_URL=postgresql://postgres.XXXXXX:VOTRE_MOT_DE_PASSE@db.XXXXXX.supabase.co:5432/postgres

# Mode SSL vers Postgres :
#   require      -> SSL activé, certificat non vérifié (Supabase, dev)
#   verify-full  -> SSL avec vérification du certificat (production stricte)
#   disable      -> pas de SSL (Postgres local de dev uniquement)
PGSSLMODE=require

# ============================================================================
# 2. Authentification de l'interface (obligatoire)
#    Les deux associés s'identifient sur une page de connexion ; le serveur
#    émet ensuite un cookie de session signé (HttpOnly). Aucun secret ne
#    transite vers le frontend.
# ============================================================================

# Comptes, séparés par ';', au format email:mot_de_passe
COCKPIT_USERS=a@duonexia.be:changez-moi;b@duonexia.be:changez-moi

# Secret servant à signer les cookies de session (>= 24 caractères aléatoires)
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COCKPIT_SESSION_SECRET=remplacez-par-une-chaine-aleatoire-de-48-caracteres-minimum

# Durée de vie d'une session en heures (défaut 12)
SESSION_TTL_HOURS=12

# Cookie en mode Secure uniquement. Mettre true en production (HTTPS), false en dev local.
COOKIE_SECURE=false

# SameSite du cookie de session : lax (défaut, même domaine racine) ou none
# (uniquement pour les tests où front et API sont sur des sites différents,
# ex. interface sur *.vercel.app et API derrière un tunnel HTTPS).
COOKIE_SAMESITE=lax

# Origines autorisées en CORS (séparées par des virgules) pour les appels
# navigateur. En production : l'origine de l'interface Vercel.
# En dev : l'origine Vite locale.
WEB_ORIGINS=http://localhost:5173

# ============================================================================
# 3. Serveur HTTP
# ============================================================================

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ============================================================================
# 4. Synchronisation planifiée (activites <- GitHub + Vercel)
# ============================================================================

# true pour démarrer le job planifié avec le serveur ; false pour un serveur
# qui ne fait que répondre à l'API (ex. pendant le dev d'interface).
RUN_JOBS=true

# Expression cron node-cron (défaut : toutes les 15 minutes)
SYNC_CRON=*/15 * * * *

# Fenêtre de remontée des événements à chaque passage (en jours)
SYNC_LOOKBACK_DAYS=30

# ============================================================================
# 5. Intégrations — GitHub (lecture seule, REST + jeton classique)
#    Sans jeton : le serveur démarre, la synchronisation GitHub est ignorée
#    proprement (et le fait apparaître dans le journal). Génération :
#    GitHub -> Settings -> Developer settings -> Personal access tokens
#    (permissions repo:read, pas de portée write en V1).
# ============================================================================

GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# ============================================================================
# 6. Intégrations — Vercel (lecture seule, REST + jeton)
#    Sans jeton : la synchronisation Vercel est ignorée. Jeton sur
#    vercel.com -> Account settings -> Tokens (lecture seule de préférence).
# ============================================================================

VERCEL_TOKEN=
VERCEL_API_URL=https://api.vercel.com
# Identifiant d'équipe Vercel si les projets appartiennent à une équipe
# (sinon, laisser vide : compte personnel).
VERCEL_TEAM_ID=

# ============================================================================
# 7. ModelRouter (réservé à la V2 — non appelé par la V1, qui est en lecture
#    seule sans agent). Les deux implémentations attendues par l'interface :
#    * anthropic  : modèle propriétaire, réservé au raisonnement complexe sur
#                   données NON sensibles ;
#    * deepseek-eu : poids ouverts servis depuis l'Union européenne (exigence
#                   RGPD : jamais l'API officielle opérée depuis la Chine pour
#                   les données d'huissiers, de paie ou de patients).
#    L'URL de base est volontairement sans valeur par défaut : on refuse par
#    construction d'expédier des données clients vers un point de terminaison
#    non contrôlé. Renseignez un fournisseur d'inférence UE (OpenAI-compatible).
# ============================================================================

ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

DEEPSEEK_EU_BASE_URL=
DEEPSEEK_EU_API_KEY=
DEEPSEEK_EU_MODEL=deepseek-chat
